{
  "name": "soireehost-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "build": "vite build --mode production && node scripts/check-bundle.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "dev:fake": "vite --mode fake"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
